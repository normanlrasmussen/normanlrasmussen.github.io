---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Norman Rasmussen">
  <section class="page-hero" style="min-height: 60vh">
    <div class="wrap narrow">
      <p class="eyebrow">404 / Page not found</p>
      <h1>That page isn't here.</h1>
      <p class="page-intro">The link may have changed, or the page may not exist yet. You can return to the homepage or browse the project archive.</p>
      <div class="action-row" style="margin-top: 22px"><a class="button" href="/">Back to homepage →</a><a class="button ghost" href="/projects/">Browse projects</a></div>
    </div>
  </section>
</BaseLayout>
