---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../data/projects';
---
<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Applied mathematics / Software engineering</p>
        <h1>Mathematical thinking. <span class="accent-text">Practical software.</span></h1>
        <p class="hero-copy">I'm Norman Rasmussen, an applied mathematics student and developer at Brigham Young University. I build optimization algorithms, data applications, and computational tools that turn technical ideas into useful systems.</p>
        <div class="action-row">
          <a class="button" href="/projects/">Explore projects <span aria-hidden="true">↗</span></a>
          <a class="button ghost" href="/research/">Research interests <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-art" aria-label="Abstract mathematical network visualization">
        <div class="hero-art-header"><span>Model / Build / Validate</span><span>NR — 001</span></div>
        <div class="hero-art-figure">
          <svg viewBox="0 0 390 255" role="img" aria-label="Network of interconnected nodes, representing mathematics and software">
            <defs><linearGradient id="gradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#648c9e"/><stop offset="1" stop-color="#2e566e"/></linearGradient></defs>
            <g stroke="#8ea8b2" stroke-width="1.4" opacity=".75" fill="none">
              <path d="M36 185 98 110 168 149 220 65 309 104 356 37 M98 110 134 35 220 65 244 196 309 104 337 217 244 196 168 149 36 185 M168 149 134 35 M168 149 309 104" />
              <circle cx="187" cy="124" r="95" stroke-dasharray="3 8" opacity=".55"/>
              <circle cx="187" cy="124" r="54" stroke-dasharray="2 6" opacity=".6"/>
              <path d="M18 229 Q187 192 369 229" opacity=".5"/>
            </g>
            <g fill="#f4f8f8" stroke="url(#gradient)" stroke-width="3">
              <circle cx="36" cy="185" r="8"/><circle cx="98" cy="110" r="9"/><circle cx="134" cy="35" r="6"/><circle cx="168" cy="149" r="14"/><circle cx="220" cy="65" r="10"/><circle cx="244" cy="196" r="9"/><circle cx="309" cy="104" r="13"/><circle cx="337" cy="217" r="7"/><circle cx="356" cy="37" r="8"/>
            </g>
            <g font-family="monospace" font-size="10" fill="#53758b"><text x="171" y="127">f(x)</text><text x="270" y="81">LP</text><text x="106" y="92">ML</text><text x="256" y="218">01</text></g>
          </svg>
        </div>
        <div class="hero-art-footer"><span>Optimization · Data · Systems</span><span>∑ / ∆</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Projects with purpose.</h2>
          <p>From computational game theory to decision-support applications, these projects bring mathematical methods into working software.</p>
        </div>
        <a class="text-link" href="/projects/">View all projects ↗</a>
      </div>
      <div class="projects-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="statement">
        <div>
          <p class="eyebrow">How I work</p>
          <h2>From model to implementation.</h2>
        </div>
        <p>I care about the whole technical process: formulating the right problem, choosing a tractable algorithm, implementing it reliably, and validating it with experiments or data. My work spans mathematical research and practical software development.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Areas of focus</p><h2>Three connected disciplines.</h2></div>
      </div>
      <div class="mini-grid">
        <div class="mini-panel"><span class="index">01 / OPTIMIZATION</span><h3>Optimization & algorithms</h3><p>Linear and integer programming, scheduling, stochastic models, and computational game theory.</p></div>
        <div class="mini-panel"><span class="index">02 / SOFTWARE</span><h3>Software engineering</h3><p>Python and web applications, data pipelines, reproducible experiments, and useful interfaces.</p></div>
        <div class="mini-panel"><span class="index">03 / DATA & ML</span><h3>Machine learning</h3><p>Forecasting, modeling, comparative evaluation, and converting predictions into decisions.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Research & background</p><h2>Academic depth. Real-world perspective.</h2><p>Research in stochastic and computational mathematics, combined with professional experience developing data-driven applications.</p></div>
      </div>
      <div class="two-column">
        <div class="info-panel"><p class="section-label">Research</p><h2>Mathematical models & experiments</h2><p>Scheduling, dynamical systems, uncertainty, network models, and game-theoretic computation.</p><a href="/research/" class="text-link">Explore research ↗</a></div>
        <div class="info-panel"><p class="section-label">Experience</p><h2>Building tools for decisions</h2><p>Software and analytics development during a UPS internship, alongside mathematical research at BYU.</p><a href="/experience/" class="text-link">View experience ↗</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
