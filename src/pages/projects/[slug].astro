---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project }
const { project } = Astro.props;
---
<BaseLayout title={project.name + ' | Norman Rasmussen'} description={project.summary}>
  <section class="detail-top">
    <div class="wrap">
      <div class="breadcrumb"><a href="/projects/">← All projects</a> / {project.category}</div>
      <p class="eyebrow">{project.subtitle} / {project.status}</p>
      <h1>{project.name}</h1>
      <p class="lead">{project.summary}</p>
      <div class="action-row">
        <a class="button" href={project.repo} target="_blank" rel="noopener noreferrer">View source on GitHub ↗</a>
        {project.demo && <a class="button ghost" href={project.demo} target="_blank" rel="noopener noreferrer">Open live demo ↗</a>}
      </div>
    </div>
  </section>
  <div class="wrap">
    <div class={'detail-banner accent-' + project.accent}><span>{project.visual}</span></div>
    <div class="detail-layout">
      <div>
        <section class="article-section">
          <p class="eyebrow">01 / Context</p>
          <h2>The problem</h2>
          <p>{project.problem}</p>
        </section>
        <section class="article-section">
          <p class="eyebrow">02 / Technical approach</p>
          <h2>Methods & implementation</h2>
          <p>{project.approach}</p>
        </section>
        <section class="article-section">
          <p class="eyebrow">03 / Deliverable</p>
          <h2>What I built</h2>
          <p>{project.outcome}</p>
        </section>
        {project.caveat && <section class="article-section"><h2>Scope & limitations</h2><p class="notice">{project.caveat}</p></section>}
        <section class="article-section">
          <h2>Explore further</h2>
          <p>Visit the repository for implementation details, documentation, and available experiment instructions. Future updates to this page may include screenshots, architecture diagrams, and validated benchmark results.</p>
          <p style="margin-top: 16px;"><a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">Browse project repository ↗</a></p>
        </section>
      </div>
      <aside class="detail-aside">
        <h3>Project overview</h3>
        <p class="aside-label">Category</p><p class="aside-value">{project.category}</p>
        <p class="aside-label">Project stage</p><p class="aside-value">{project.status}</p>
        <p class="aside-label">Tools & methods</p>
        <div class="tag-row">{project.stack.map((tag) => <span class="tag">{tag}</span>)}</div>
        <a class="text-link" href="/projects/">← Browse all work</a>
      </aside>
    </div>
  </div>
</BaseLayout>
