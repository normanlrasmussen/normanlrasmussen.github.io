---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Résumé & Contact | Norman Rasmussen"
  description="Download Norman Rasmussen's résumé and connect about software engineering, applied mathematics, optimization, and research."
>
  <section class="page-hero resume-page-hero">
    <div class="wrap">
      <p class="eyebrow">Portfolio / Résumé & Contact</p>
      <h1>Let's work on something meaningful.</h1>
      <p class="page-intro">I'm interested in opportunities where rigorous mathematical thinking meets useful software: optimization, engineering, data, and computational research.</p>
      <div class="action-row resume-hero-actions">
        <a class="button" href="/resume.pdf" download="Norman_Rasmussen_Resume.pdf">Download résumé (PDF) <span aria-hidden="true">↓</span></a>
        <a class="button ghost" href="https://www.linkedin.com/in/norman-rasmussen/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="page-content">
    <div class="wrap">
      <div class="two-column resume-contact-grid">
        <article class="info-panel resume-download-panel">
          <p class="section-label">Professional profile</p>
          <h2>Résumé & experience</h2>
          <p>B.S. in Applied & Computational Mathematics (ACME), Brigham Young University. Expected graduation: April 2027.</p>
          <p>Research in operations research and numerical methods, plus production software engineering experience developing Python applications, optimization models, and decision-support tools.</p>
          <div class="resume-highlights">
            <span>Optimization & algorithms</span>
            <span>Python, SQL & software</span>
            <span>Modeling & machine learning</span>
          </div>
          <a class="text-link" href="/resume.pdf" download="Norman_Rasmussen_Resume.pdf">Download one-page résumé ↗</a>
          <p class="resume-secondary-link"><a href="/experience/" class="text-link">Explore experience & skills ↗</a></p>
        </article>

        <article class="info-panel contact-panel">
          <p class="section-label">Get in touch</p>
          <h2>Contact & profiles</h2>
          <p>For professional inquiries, you can reach me by email or connect through the profiles below.</p>
          <div class="contact-method">
            <span class="contact-label">Email</span>
            <span class="contact-address" id="contact-address">norman03 [at] byu [dot] edu</span>
            <span class="contact-hint">Address shown directly when JavaScript is enabled.</span>
          </div>
          <div class="contact-method">
            <span class="contact-label">LinkedIn</span>
            <a class="contact-profile-link" href="https://www.linkedin.com/in/norman-rasmussen/" target="_blank" rel="noopener noreferrer">linkedin.com/in/norman-rasmussen/ ↗</a>
          </div>
          <div class="contact-method">
            <span class="contact-label">GitHub</span>
            <a class="contact-profile-link" href="https://github.com/normanlrasmussen" target="_blank" rel="noopener noreferrer">github.com/normanlrasmussen ↗</a>
          </div>
        </article>
      </div>
      <div class="cta-panel resume-cta">
        <p class="eyebrow">Explore my work</p>
        <h2>See the projects behind the résumé.</h2>
        <p>Explore working software, optimization experiments, game-theoretic solvers, and research-driven models.</p>
        <div class="action-row">
          <a class="button ghost" href="/projects/">Browse projects ↗</a>
          <a class="button ghost" href="/research/">Research interests ↗</a>
        </div>
      </div>
    </div>
  </section>
  <script>
    // Assemble on the client rather than placing a plain mailto: address in static HTML.
    // This discourages basic static scrapers; it does not stop JavaScript-aware crawlers.
    const target = document.getElementById('contact-address');
    if (target) {
      const local = ['03', 'norman'].reverse().join('');
      const domain = ['edu', 'byu'].reverse().join('.');
      const address = local + String.fromCharCode(64) + domain;
      const link = document.createElement('a');
      link.href = 'mailto:' + address;
      link.textContent = address;
      link.setAttribute('aria-label', 'Email Norman Rasmussen');
      target.replaceChildren(link);
      const hint = target.parentElement?.querySelector('.contact-hint');
      if (hint) hint.textContent = 'Select to compose an email.';
    }
  </script>
</BaseLayout>
