---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Résumé & Contact | Norman Rasmussen" description="Résumé overview and ways to connect with Norman Rasmussen.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Portfolio / Résumé & Contact</p>
      <h1>Let's connect.</h1>
      <p class="page-intro">I'm interested in opportunities where mathematical reasoning and software engineering help solve complex problems, especially across optimization, data, and computational systems.</p>
    </div>
  </section>
  <section class="page-content">
    <div class="wrap">
      <div class="two-column">
        <div class="info-panel">
          <p class="section-label">Professional profile</p>
          <h2>Résumé overview</h2>
          <p>Applied and Computational Mathematics (ACME), Brigham Young University. Expected April 2027.</p>
          <p>Experience in Python and SQL data applications, algorithm development, optimization, machine learning, and mathematical research.</p>
          <p class="notice">A downloadable résumé PDF has not yet been added. The experience page contains the current public overview.</p>
          <a class="text-link" href="/experience/">View experience and skills ↗</a>
        </div>
        <div class="info-panel">
          <p class="section-label">Connect</p>
          <h2>GitHub & projects</h2>
          <p>Explore public repositories, code samples, and technical experiments through GitHub.</p>
          <p><a class="text-link" href="https://github.com/normanlrasmussen" target="_blank" rel="noopener noreferrer">github.com/normanlrasmussen ↗</a></p>
          <p>Additional contact options and a résumé download can be added here once preferred details are provided.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
